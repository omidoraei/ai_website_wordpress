       "settings": {
        "tabs": [
         {
          "_id": "0f6a473",
          "tab_title": "What do we need to get started?",
          "tab_content": "A product owner, access to a representative dataset and one engineer. We run the first workshop inside your workspace, so nothing leaves your environment."
         },
         {
          "_id": "2efe35a",
          "tab_title": "Which models can Aurora orchestrate?",
          "tab_content": "Aurora is model-agnostic. Route between OpenAI, Anthropic, Google, Mistral and your own fine-tunes per step, and switch providers without touching application code."
         },
         {
          "_id": "fba08b6",
          "tab_title": "How do you handle data privacy?",
          "tab_content": "Data can stay in the EU or the US, is encrypted in transit and at rest, and PII is redacted before it reaches a model. We are SOC 2 Type II certified and GDPR ready."
         },
         {
          "_id": "3d7c0ae",
          "tab_title": "Can we self-host?",
          "tab_content": "Yes. The Enterprise plan ships as a container image you can run inside your own VPC, with the control plane either managed or fully air-gapped."
         },
         {
          "_id": "d3300d5",
          "tab_title": "What does onboarding cost?",
          "tab_content": "Growth includes a guided 30-day onboarding. Enterprise engagements include a named success manager and a quarterly review of your agent portfolio."
         },
         {
          "_id": "653e33f",
          "tab_title": "Is there a long-term contract?",
          "tab_content": "Monthly plans are month-to-month. Annual agreements include a discount and a commercial SLA with committed uptime and response times."
         }
